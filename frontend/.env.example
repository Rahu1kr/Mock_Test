# Frontend environment template.
#
# Copy to .env.local for local development (.env.local is gitignored and
# overrides .env). On Vercel, set these in the project's Environment Variables
# dashboard instead of committing a file.
#
# NEXT_PUBLIC_* values are inlined into the bundle at BUILD time, so changing
# this requires a rebuild/redeploy — restarting the server is not enough.

# Local laptop only:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Testing on an iPad over the LAN (use your Mac's IP, not localhost):
#   NEXT_PUBLIC_API_BASE_URL=http://192.168.31.179:4000
# Production:
#   NEXT_PUBLIC_API_BASE_URL=https://<your-render-service>.onrender.com

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
