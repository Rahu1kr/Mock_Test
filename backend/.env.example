# Backend environment.
# Local dev: copy to .env and fill in. Production: set these in your host's
# dashboard (Render / Railway), never commit real values.

PORT=4000

# MongoDB Atlas connection string, including the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/geo-app?retryWrites=true&w=majority

# Signs login tokens. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Comma-separated list of allowed frontend origins (no trailing slash).
# Production example: https://geo-pyq.vercel.app
CORS_ORIGIN=http://localhost:3000
